# ==============================================================================
# IT Department Feedback and Survey System - Environment Configuration
# ==============================================================================

# Supabase Authentication & Database Provider
# In production, replace placeholders with your actual Supabase project URL and service keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cryptographic AES-256-GCM Encryption Key (32 bytes / 64 hex characters)
# IMPORTANT: This key is used EXCLUSIVELY for encrypting sensitive feedback data at rest.
# Passwords MUST NEVER use reversible AES encryption; passwords use secure one-way scrypt/bcrypt hashing.
FEEDBACK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Next.js Application URL (used for password recovery links and authentication redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Outbound Email / SMTP Provider (for Password Recovery and Broadcast Notifications)
# Configure these when using an external SMTP server (e.g. SendGrid, Mailgun, Amazon SES, Postmark)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASSWORD=your-secure-smtp-password
SMTP_FROM=IT Department Portal <noreply@itdept.edu>

# Standalone / Local Mock Storage Mode (set to false when connected to live Supabase backend)
USE_LOCAL_MOCK_STORAGE=true
