# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cryptographic AES-256-GCM Encryption Key (32 bytes hex encoded)
# Default demo key provided below for out-of-the-box operation:
FEEDBACK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable Local Mock Storage when Supabase URL is placeholder
USE_LOCAL_MOCK_STORAGE=true

