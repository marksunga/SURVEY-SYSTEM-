    "test:system": "tsc tests/e2e/test-survey-flow.ts --target es2022 --module commonjs --outDir dist-test && node dist-test/tests/e2e/test-survey-flow.js && node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\""
